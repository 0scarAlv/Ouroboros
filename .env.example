# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (optional). Defaults to db.sqlite3 in the project root.
# DATABASE_URL=sqlite:////absolute/path/to/db.sqlite3
# DATABASE_URL=postgres://user:password@localhost:5432/ouroboros
# Encrypted SQLite (requirements/sqlcipher.txt); the key file holds 64 hex chars:
# DATABASE_URL=sqlcipher:////absolute/path/to/db.sqlite3?key_file=/absolute/path/to/db.key

# Only used by docker-compose.yml to start a local Postgres
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=5432

# Security (optional, defaults shown)
# PASSWORD_MIN_LENGTH=10
# SESSION_HOURS=8
# LOGIN_FAILURE_LIMIT=5
# LOGIN_LOCKOUT_MINUTES=15

# On-premise profile (config.settings.onprem)
# DATA_DIR=C:/ProgramData/MyProduct    # database, uploads and logs
# USE_HTTPS=False                       # True only behind a TLS proxy
# BACKUP_DIR=C:/ProgramData/MyProduct/backups   # default: DATA_DIR/backups
